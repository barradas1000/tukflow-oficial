{
  "version": 2,
  "builds": [
    { "src": "oficial/**/*.html", "use": "@vercel/static" },
    { "src": "oficial/**", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "languages/**", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/oficial/index-3.html" },
    { "src": "^/(.*)$", "dest": "/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
